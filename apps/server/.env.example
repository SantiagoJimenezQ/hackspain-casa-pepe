###############################
#        Casa Pepe API        #
###############################
# Copy to .env.local and adjust. .env.local is ignored by git; never commit real credentials.

# ---------- Runtime ----------
# local | development | production | test
ENVIRONMENT=local
# HTTP port the API listens on. Routes are served under /api, OpenAPI under /documentation
PORT=3000
# Public URL of this service. Used to build the callback URLs sent to HappyRobot and to the recovery environment
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Persistence (Postgres) ----------
# Supabase: Project settings > Database > Connection string (URI). Use the session pooler on port 5432; TLS is enabled automatically for Supabase hosts
#   SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Any other Postgres works too, for example a local install
# true | false. Logs every SQL query, useful to diagnose latency
DATABASE_QUERY_LOGGING=false
# Postgres connections kept by this process. Keep 1 on serverless deployments; use 5 or more on a long-running server so concurrent requests and the scheduler do not wait for each other
DATABASE_POOL_MAXIMUM=1
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casa_pepe

# ---------- Authentication ----------
# Single API key for the frontend and demo controls, sent as: Authorization: API <API_KEY>
API_KEY=change-me-api-key

# ---------- Outbound webhooks ----------
# Consumers (the UI included) subscribe through POST /api/webhooks/subscriptions and receive every activity event
# Time to wait for the subscriber to answer each delivery
WEBHOOK_TIMEOUT_MILLISECONDS=5000
# Deliveries are retried with exponential backoff (2s, 4s, 8s... capped at 60s) until this many attempts
WEBHOOK_MAXIMUM_ATTEMPTS=5

# ---------- Engineer calls ----------
# Provider selection is independent of simulated/live mode.
ENGINEER_CALL_PROVIDER=happyrobot
# Optional override; when absent, HAPPYROBOT_MODE remains the compatibility fallback.
# ENGINEER_CALL_MODE=simulated
# ElevenLabs live calls use the agent and phone number already configured in its UI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_POLL_INTERVAL_MILLISECONDS=5000

# ---------- HappyRobot and simulation ----------
# simulated: the answers come from the scenario script after SIMULATED_CALL_DELAY_MILLISECONDS
# live: the service triggers a real HappyRobot call and waits for POST /api/webhooks/happyrobot
HAPPYROBOT_MODE=simulated
# URL of the HappyRobot webhook trigger that starts the call use case (required in live mode)
HAPPYROBOT_TRIGGER_URL=
# Sent as Authorization: Bearer <HAPPYROBOT_API_KEY> when triggering the call
HAPPYROBOT_API_KEY=
# Shared secret HappyRobot must send back in the x-happyrobot-signature header of POST /api/webhooks/happyrobot
HAPPYROBOT_WEBHOOK_SECRET=change-me-happyrobot-webhook-secret
# Delay before the simulated call result arrives
SIMULATED_CALL_DELAY_MILLISECONDS=4000

# ---------- Recovery environment ----------
# simulated: outcomes come from the scenario after SIMULATED_RECOVERY_DELAY_MILLISECONDS
# http: POST {RECOVERY_ENVIRONMENT_URL}/recovery/actions and GET {RECOVERY_ENVIRONMENT_URL}/recovery/services/:service/health
RECOVERY_MODE=simulated
RECOVERY_ENVIRONMENT_URL=http://localhost:4100
# Sent as Authorization: Bearer <RECOVERY_ENVIRONMENT_API_KEY> to the recovery environment
RECOVERY_ENVIRONMENT_API_KEY=
# Shared secret the recovery environment must send in the x-recovery-signature header of POST /api/webhooks/recovery
RECOVERY_WEBHOOK_SECRET=change-me-recovery-webhook-secret
# Delay before the simulated recovery result arrives
SIMULATED_RECOVERY_DELAY_MILLISECONDS=1500

# ---------- Demo scenario ----------
# On-call engineer the agent calls and assigns preparation tasks to
DEMO_ENGINEER_NAME=Marta Ruiz
DEMO_ENGINEER_PHONE=+34600000000
DEMO_ENGINEER_ROLE=Platform on-call engineer

# ---------- Agent execution limits ----------
# Decision cycles allowed per run before the agent stops and asks for a manual cycle (POST /api/agent/cycle)
AGENT_MAXIMUM_CYCLES_PER_RUN=60
# Plan steps executed in a single cycle
AGENT_MAXIMUM_STEPS_PER_CYCLE=6
# Attempts per plan step before it is marked as failed
AGENT_MAXIMUM_STEP_ATTEMPTS=2
# Time the operator has to approve or reject before the approval expires and is requested again
AGENT_APPROVAL_TIMEOUT_MILLISECONDS=600000
# Time a tool call may run (including recovery callbacks) before it is marked as timed out
AGENT_TOOL_TIMEOUT_MILLISECONDS=20000
# Time a phone call to the engineer (call_engineer / contact_engineer) may take before it is marked as timed out; a real call needs minutes
AGENT_CALL_TIMEOUT_MILLISECONDS=300000

# ---------- LLM decision provider ----------
# The LLM is the default decision provider; there is no silent rule-based fallback.
# Leave provider fields blank to start the server without credentials. An agent call
# then fails with a sanitized configuration error until all three are configured.
# Pick the active provider with one variable: openai | deepseek | (empty = the plain LLM_* below).
# Each preset falls back to the plain LLM_* value for anything it leaves empty, so both sets of
# credentials can live here at once and switching provider never touches the code.
LLM_PROVIDER=

# OpenAI. gpt-5 models reject function tools unless reasoning_effort is none on /chat/completions,
# and the client already sends max_completion_tokens for api.openai.com
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-5.6-luna
LLM_OPENAI_FAST_MODEL=gpt-5.4-nano
LLM_OPENAI_REASONING_EFFORT=none

# DeepSeek, directly or through an OpenAI-compatible gateway such as Helmcode
LLM_DEEPSEEK_BASE_URL=https://api.helmcode.com/v1
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-v4-flash
LLM_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
LLM_DEEPSEEK_REASONING_EFFORT=low

# Base URL for an OpenAI-compatible provider (HTTPS required; loopback HTTP is allowed for tests)
LLM_BASE_URL=
# Sent as Authorization: Bearer <LLM_API_KEY>
LLM_API_KEY=
# Provider model identifier; no provider or model is guessed by the server
LLM_MODEL=
# Per-request timeout and bounds for each bounded LLM decision loop. The client
# rejects request/response payloads above 1 MiB; it never truncates plan JSON.
LLM_TIMEOUT_MILLISECONDS=30000
LLM_MAXIMUM_TURNS=24
LLM_MAXIMUM_OUTPUT_TOKENS=8192
# Optional. Sent as reasoning_effort for models that reason before answering (none | low | medium | high).
# "none" removes the hidden reasoning and makes each decision much faster on DeepSeek-style models
LLM_REASONING_EFFORT=
# Fast model for quick, bounded decisions such as GET /customers/priorities?mode=llm. Falls back to LLM_MODEL when empty
LLM_FAST_MODEL=
# Timeout for the fast model; past it the deterministic ranking is returned
LLM_FAST_TIMEOUT_MILLISECONDS=5000

# MVP operator email. Simulated mode never sends mail.
INCIDENT_EMAIL_MODE=simulated
RESEND_API_KEY=
# Secret shown by Resend for the email.received webhook (whsec_...)
RESEND_WEBHOOK_SECRET=
INCIDENT_EMAIL_FROM=
INCIDENT_EMAIL_TO=

# Stream public model summaries through the authenticated activity SSE feed.
LLM_STREAM_OUTPUT=false
